generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
}

enum Density {
  COMPACT
  COMFORTABLE
  SPACIOUS
}

enum Theme {
  default
  dark
  light
  neo_brutalism
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  avatar    String?
  createdAt DateTime @default(now())
}

model TopLink {
  id        String   @id @default(cuid())
  icon      String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model NormalLink {
  id          String     @id @default(cuid())
  icon        String?
  url         String
  title       String
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  linkGroup   LinkGroup? @relation(fields: [linkGroupId], references: [id])
  linkGroupId String?
}

model LinkGroup {
  id        String       @id @default(cuid())
  icon      String?
  name      String
  order     Int          @default(0)
  links     NormalLink[]
  createdAt DateTime     @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  source    Boolean  @default(true)
  shareBar  Boolean  @default(true)
  density   Density  @default(COMFORTABLE)
  theme     Theme    @default(default)
  createdAt DateTime @default(now())
}
